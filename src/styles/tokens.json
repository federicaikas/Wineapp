      "accent-tertiary": {
        "value": "#7A9A3B",
        "type": "color",
        "description": "Verde oliva chiaro / Pistacchio — Eyebrow, tag e badge"
      },
      "text-muted": {
        "value": "#706880",
        "type": "color",
